{
  "name": "repaint",
  "version": "1.0.0",
  "private": true,
  "description": "Repaint — interactive 3D viewer for a Blender apartment scene with live wall-paint recoloring.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "serve:dist": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:portable": "pnpm run build && node scripts/make-portable.mjs",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "tsc --noEmit && oxlint && oxfmt --check"
  },
  "dependencies": {
    "lil-gui": "^0.21.0",
    "stats.js": "^0.17.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/stats.js": "^0.17.4",
    "@types/three": "^0.185.4",
    "happy-dom": "^20.11.2",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "typescript": "^5.9.2",
    "vite": "^8.2.1",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@11.10.0"
}
